<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task 5 - User Management</title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container">

    <h1>User Management System</h1>

    <form id="userForm">

        <input
            type="text"
            id="name"
            placeholder="Enter Name"
            required
        >

        <input
            type="email"
            id="email"
            placeholder="Enter Email"
            required
        >

        <button type="submit">
            Add User
        </button>

    </form>

    <table>

        <thead>

            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody id="userTable">

        </tbody>

    </table>

</div>

<script src="/js/script.js"></script>

</body>
</html>